{
  "name": "@kky42/pievo-server",
  "version": "2.4.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kky42/pievo.git",
    "directory": "packages/server"
  },
  "type": "module",
  "description": "Pievo server — a self-hostable zero-exec control plane for scheduled agent loops.",
  "bin": {
    "pievo-server": "scripts/pievo-server.mjs"
  },
  "files": [
    ".output",
    "drizzle",
    "scripts/pievo-server.mjs",
    "scripts/server-cli-lib.mjs",
    "scripts/prestart.mjs",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/copy-pglite-assets.mjs",
    "build:publish": "vite build && node scripts/copy-pglite-assets.mjs --strict",
    "start": "node scripts/prestart.mjs && node .output/server/index.mjs",
    "routes:generate": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm build:publish"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@base-ui/react": "^1.6.0",
    "@electric-sql/pglite": "^0.5.4",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "better-auth": "^1.6.19",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.5",
    "postgres": "^3.4.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/router-cli": "1.167.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
