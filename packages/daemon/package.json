{
  "name": "@kky42/pievo",
  "version": "5.0.0",
  "description": "Pievo — run scheduled coding-agent loops (Claude Code, Codex, or Pi) across your devices. `pievo server` hosts the dashboard; `pievo daemon` runs loops on each device.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kky42/pievo.git",
    "directory": "packages/daemon"
  },
  "type": "module",
  "bin": {
    "pievo": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/clean-dist.mjs && tsc"
  },
  "dependencies": {
    "@kky42/pievo-server": "^5.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  }
}
